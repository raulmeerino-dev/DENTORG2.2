# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dentcore:dentcore_dev_pass@localhost:5432/dentcore
DB_ENCRYPTION_KEY=clave-de-cifrado-pgcrypto-minimo-32-chars

# ─── Auth JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia-esto-por-una-clave-muy-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=dentcore_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ─── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8011
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,::1
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID
ENVIRONMENT=development

# ─── Datos de la clínica (aparecen en PDFs de facturas y presupuestos) ────────
CLINICA_NOMBRE=Clínica Dental DentCore
CLINICA_DIRECCION=Calle Mayor 1, 28001
CLINICA_CIUDAD=Madrid
CLINICA_TELEFONO=91 123 45 67
CLINICA_EMAIL=info@dentcore.es

# ─── Verifactu / AEAT (RD 1007/2023) ─────────────────────────────────────────
# NIF del titular (empresa o autónomo) que emite las facturas
NIF_EMISOR=B12345678

# IA para DentCore Voice Assistant
# LLM_PROVIDER puede ser "auto", "ollama" u "openai".
# En auto se prueba Ollama, despues OpenAI y finalmente error seguro/mock local segun cliente.
# La key nunca debe exponerse en frontend.
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=ollama,openai,mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12

# Receta privada/digital
# disabled = sin proveedor externo; mock = integracion simulada no certificada; real = proveedor real configurado.
RECETA_PROVIDER=disabled
RECETA_PROVIDER_BASE_URL=
RECETA_PROVIDER_CLIENT_ID=
RECETA_PROVIDER_CLIENT_SECRET=
RECETA_PROVIDER_CERT_PATH=
RECETA_PROVIDER_TIMEOUT=20
